DHAN_SERVICE=deeplob-paper
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
CSV_FILE=/var/lib/dhan-engine/api-scrip-master.csv
DEEPLOB_INDEXES=NIFTY
DEEPLOB_LEVELS=200
# Persist every complete bid+ask book event. Inference is independently sampled at 250ms.
DEEPLOB_RECORD_SAMPLE_INTERVAL_MS=0
DEEPLOB_SAMPLE_INTERVAL_MS=250
DEEPLOB_PREMODEL_SAMPLE_INTERVAL_MS=250
DEEPLOB_PREMODEL_SIGNAL_INTERVAL_SEC=1
DEEPLOB_PREMODEL_SEQUENCE_LENGTH=12
DEEPLOB_PREMODEL_SIGNAL_THRESHOLD=0.08
DEEPLOB_PREMODEL_HORIZON_SEC=600
DEEPLOB_QUEUE_SIZE=4096
DEEPLOB_ROWS_PER_FILE=10000
DEPTH_QUEUE_HEALTH_INTERVAL_SEC=10
DEEPLOB_FLUSH_SEC=300
DEEPLOB_OUTPUT_DIR=/var/lib/dhan-engine/deeplob
DEEPLOB_S3_BUCKET=dhan-engine-market-data-774075584062
DEEPLOB_S3_PREFIX=market-data/deeplob
DEEPLOB_DASHBOARD_MAX_POINTS=5000
DEEPLOB_DASHBOARD_CACHE_SECONDS=15
TRIWAVE_VIEWER_ENABLED=1
TRIWAVE_VIEWER_PORT=8080
# Set this secret on EC2 before exposing port 8080 publicly.
TRIWAVE_VIEWER_TOKEN=
DEEPLOB_PARTITION_TIMEZONE=Asia/Kolkata
DEEPLOB_RECORDER_REQUIRE_FULLQUOTE=1
DEEPLOB_MAX_FULLQUOTE_AGE_MS=1500
DEEPLOB_MODEL_PATH=/var/lib/dhan-engine/models/deeplob.pt
DEEPLOB_METADATA_PATH=/var/lib/dhan-engine/models/deeplob.json
DEEPLOB_MODEL_S3_URI=s3://dhan-engine-market-data-774075584062/models/production/deeplob.pt
DEEPLOB_METADATA_S3_URI=s3://dhan-engine-market-data-774075584062/models/production/deeplob.json
DEEPLOB_CONFIDENCE_THRESHOLD=0.65
DEEPLOB_STALE_AFTER_SEC=1.5
DEEPLOB_DELETE_AFTER_UPLOAD=1
DEEPLOB_OPTION_PAPER_ENABLED=1
DEEPLOB_OPTION_SELECTION_RETRY_SEC=60
DEEPLOB_OPTION_PAPER_CAPITAL=500000
DEEPLOB_OPTION_PAPER_CONFIDENCE=0.65
DEEPLOB_OPTION_PAPER_PRESSURE=0.05
DEEPLOB_OPTION_PAPER_CONFIRMATIONS=3
DEEPLOB_OPTION_PAPER_COOLDOWN_SEC=60
DEEPLOB_OPTION_PAPER_MAX_QUOTE_AGE_SEC=2
DEEPLOB_OPTION_PAPER_TAKE_PROFIT_PCT=2.0
DEEPLOB_OPTION_PAPER_STOP_LOSS_PCT=1.5
DEEPLOB_OPTION_PAPER_MAX_HOLD_SEC=600
DEEPLOB_OPTION_PAPER_ENFORCE_MARKET_HOURS=1
DEEPLOB_OPTION_PAPER_MARKET_START=09:15
DEEPLOB_OPTION_PAPER_ENTRY_CUTOFF=15:25
DEEPLOB_OPTION_PAPER_MARKET_END=15:30
DEEPLOB_HEALTH_INTERVAL_SEC=60
DEEPLOB_OPTION_PAPER_ROUND_TRIP_FEE=60
DEEPLOB_OPTION_PAPER_MIN_COST_MULTIPLE=2
DEEPLOB_OPTION_PAPER_DEPTH_EXIT_ENABLED=1
DEEPLOB_OPTION_PAPER_EXIT_CONFIRMATIONS=3
DEEPLOB_OPTION_PAPER_MIN_HOLD_SEC=5
# Isolated V1/V2 long-option regime portfolio. V1 derives a persistent market
# state from the already-selected CE/PE quotes plus the synchronized NIFTY
# future 200-depth snapshot. V2 buys only CE or PE and writes its closed trades
# into the existing consolidated S3 daily ledger under profile=regime_v2.
DEEPLOB_REGIME_V2_ENABLED=1
DEEPLOB_REGIME_V2_CAPITAL=500000
DEEPLOB_REGIME_V2_MAX_QUOTE_AGE_SEC=2
DEEPLOB_REGIME_V2_OBSERVATION_SEC=12
DEEPLOB_REGIME_V2_MIN_SAMPLES=8
DEEPLOB_REGIME_V2_STATE_CONFIRMATIONS=3
DEEPLOB_REGIME_V2_REVERSAL_CONFIRMATIONS=2
DEEPLOB_REGIME_V2_MIN_STATE_SCORE=0.58
DEEPLOB_REGIME_V2_FEE_BUFFER_MULTIPLE=1.25
DEEPLOB_REGIME_V2_ROUND_TRIP_FEE=60
DEEPLOB_REGIME_V2_MAX_LOSS_PCT=1.25
DEEPLOB_REGIME_V2_MARKET_START=09:15
DEEPLOB_REGIME_V2_ENTRY_CUTOFF=15:24
DEEPLOB_REGIME_V2_MARKET_END=15:25
DEEPLOB_PREMODEL_HORIZONS_SEC=30,60,120,300
DEEPLOB_PREMODEL_OPTION_BETA_PCT_PER_FUTURE_BPS=0.10
# Legacy same-horizon fan-out is retained for rollback compatibility only. The
# adaptive scalp below owns short-horizon paper entries by default.
DEEPLOB_SCALP_PAPER_ENABLED=0
DEEPLOB_SCALP_PAPER_CAPITAL=500000
DEEPLOB_SCALP_PAPER_CONFIDENCE=0.60
DEEPLOB_SCALP_PAPER_PRESSURE=0.04
DEEPLOB_SCALP_PAPER_CONFIRMATIONS=2
DEEPLOB_SCALP_PAPER_COOLDOWN_SEC=20
DEEPLOB_SCALP_PAPER_MAX_QUOTE_AGE_SEC=2
DEEPLOB_SCALP_PAPER_TAKE_PROFIT_PCT=1.50
DEEPLOB_SCALP_PAPER_STOP_LOSS_PCT=0.75
DEEPLOB_SCALP_PAPER_MAX_HOLD_SEC=120
DEEPLOB_SCALP_PAPER_ENFORCE_MARKET_HOURS=1
DEEPLOB_SCALP_PAPER_MARKET_START=09:15
DEEPLOB_SCALP_PAPER_ENTRY_CUTOFF=15:25
DEEPLOB_SCALP_PAPER_MARKET_END=15:30
# Independent short-horizon paper portfolio. It reuses the synchronized future
# book and selected CE/PE quotes; it does not create another broker connection.
DEEPLOB_SCALP_ENABLED=1
DEEPLOB_SCALP_CAPITAL=500000
DEEPLOB_SCALP_SAMPLE_INTERVAL_MS=250
DEEPLOB_SCALP_SEQUENCE_LENGTH=16
DEEPLOB_SCALP_SIGNAL_INTERVAL_SEC=1
DEEPLOB_SCALP_HORIZONS_SEC=10,20,30,60
DEEPLOB_SCALP_MIN_ALIGNMENT=0.75
DEEPLOB_SCALP_MIN_STRENGTH=0.14
DEEPLOB_SCALP_CONFIDENCE=0.58
DEEPLOB_SCALP_CONFIRMATIONS=2
DEEPLOB_SCALP_COOLDOWN_SEC=15
DEEPLOB_SCALP_MAX_QUOTE_AGE_SEC=2
DEEPLOB_SCALP_TAKE_PROFIT_PCT=1.2
DEEPLOB_SCALP_STOP_LOSS_PCT=0.8
DEEPLOB_SCALP_MAX_HOLD_SEC=60
DEEPLOB_SCALP_ROUND_TRIP_FEE=60
DEEPLOB_SCALP_MIN_COST_MULTIPLE=2
DEEPLOB_SCALP_EXIT_CONFIRMATIONS=3
DEEPLOB_SCALP_MIN_HOLD_SEC=5
DEEPLOB_SCALP_MARKET_START=09:15
DEEPLOB_SCALP_ENTRY_CUTOFF=15:24
DEEPLOB_SCALP_MARKET_END=15:25
# Third isolated paper portfolio. It consumes the existing synchronized NIFTY
# Full Quote + 200-depth snapshot and performs no broker or S3 call per tick.
DEEPLOB_REVERSAL_ENABLED=1
DEEPLOB_REVERSAL_SAMPLE_INTERVAL_MS=250
DEEPLOB_REVERSAL_SEQUENCE_LENGTH=24
DEEPLOB_REVERSAL_SIGNAL_INTERVAL_SEC=1
DEEPLOB_REVERSAL_HORIZONS_SEC=15,30,60,90
DEEPLOB_REVERSAL_MIN_TURN_SCORE=0.58
DEEPLOB_REVERSAL_MIN_EVENT_QUALITY=0.30
DEEPLOB_REVERSAL_MIN_ADVERSE_BPS=1.5
DEEPLOB_REVERSAL_QUEUE_SIZE=64
DEEPLOB_REVERSAL_PRIOR_S3_KEY=analysis/deeplob/reversal-prior/latest.json
DEEPLOB_REVERSAL_PAPER_ENABLED=1
DEEPLOB_REVERSAL_PAPER_CAPITAL=500000
DEEPLOB_REVERSAL_PAPER_CONFIDENCE=0.70
DEEPLOB_REVERSAL_PAPER_PRESSURE=0
DEEPLOB_REVERSAL_PAPER_CONFIRMATIONS=2
DEEPLOB_REVERSAL_PAPER_COOLDOWN_SEC=30
DEEPLOB_REVERSAL_PAPER_MAX_QUOTE_AGE_SEC=2
DEEPLOB_REVERSAL_PAPER_TAKE_PROFIT_PCT=1.5
DEEPLOB_REVERSAL_PAPER_STOP_LOSS_PCT=0.8
DEEPLOB_REVERSAL_PAPER_MAX_HOLD_SEC=120
DEEPLOB_REVERSAL_PAPER_ROUND_TRIP_FEE=60
DEEPLOB_REVERSAL_PAPER_MIN_COST_MULTIPLE=2
DEEPLOB_REVERSAL_PAPER_DEPTH_EXIT_ENABLED=1
DEEPLOB_REVERSAL_PAPER_EXIT_CONFIRMATIONS=3
DEEPLOB_REVERSAL_PAPER_MIN_HOLD_SEC=5
DEEPLOB_REVERSAL_PAPER_MARKET_START=09:15
DEEPLOB_REVERSAL_PAPER_ENTRY_CUTOFF=15:24
DEEPLOB_REVERSAL_PAPER_MARKET_END=15:25
DEEPLOB_TRADE_SUMMARY_S3_PREFIX=paper-trades/deeplob
DEEPLOB_TRADE_SUMMARY_S3_QUEUE_SIZE=256
DEEPLOB_POST_MARKET_ENABLED=1
DEEPLOB_POST_MARKET_RUN_AFTER=15:35
DEEPLOB_POST_MARKET_SIDEWAYS_BPS=5
DEEPLOB_POST_MARKET_S3_PREFIX=analysis/deeplob
