DHAN_SERVICE=stock-option-paper
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
CSV_FILE=/var/lib/dhan-engine-stock-options/api-scrip-master.csv
LOG_LEVEL=INFO

# Deliberately restricted to the first two isolated stock-option profiles.
STOCK_OPTION_SYMBOLS=HDFCBANK,RELIANCE
STOCK_OPTION_MAX_FULLQUOTE_AGE_MS=1500
STOCK_OPTION_MAX_FUTURE_SPREAD_BPS=25
STOCK_OPTION_EXECUTION_PROBE_QTY=1
STOCK_OPTION_SELECTION_RETRY_SEC=30
STOCK_OPTION_HEALTH_INTERVAL_SEC=60

# Raw FUTSTK 200-depth storage. Use the same bucket as NIFTY but a separate prefix.
DEEPLOB_LEVELS=200
DEEPLOB_RECORD_SAMPLE_INTERVAL_MS=250
DEEPLOB_QUEUE_SIZE=2048
DEEPLOB_ROWS_PER_FILE=5000
DEEPLOB_FLUSH_SEC=300
DEEPLOB_DELETE_AFTER_UPLOAD=1
DEEPLOB_PARTITION_TIMEZONE=Asia/Kolkata
DEEPLOB_S3_BUCKET=
STOCK_OPTION_OUTPUT_DIR=/var/lib/dhan-engine-stock-options/deeplob
STOCK_OPTION_S3_PREFIX=market-data/deeplob-stock-options
STOCK_OPTION_TRADE_S3_PREFIX=paper-trades/stock-options
STOCK_OPTION_TRADE_S3_QUEUE_SIZE=128

# One independent PR-283 hybrid V1/V2 portfolio per stock.
STOCK_OPTION_REGIME_ENABLED=1
STOCK_OPTION_REGIME_CAPITAL_PER_SYMBOL=500000
STOCK_OPTION_REGIME_MAX_QUOTE_AGE_SEC=2
STOCK_OPTION_REGIME_OBSERVATION_SEC=12
STOCK_OPTION_REGIME_MIN_SAMPLES=8
STOCK_OPTION_REGIME_STATE_CONFIRMATIONS=3
STOCK_OPTION_REGIME_REVERSAL_CONFIRMATIONS=2
STOCK_OPTION_REGIME_MIN_STATE_SCORE=0.58
STOCK_OPTION_REGIME_HYBRID_ENABLED=1
STOCK_OPTION_REGIME_HYBRID_BOOK_WEIGHT=0.55
STOCK_OPTION_REGIME_HYBRID_MIN_UPDATES=4
STOCK_OPTION_REGIME_FEE_BUFFER_MULTIPLE=1.25
STOCK_OPTION_REGIME_ROUND_TRIP_FEE=60
STOCK_OPTION_REGIME_CATASTROPHIC_LOSS_PCT=8.0
STOCK_OPTION_REGIME_CATASTROPHIC_CONFIRMATIONS=3
STOCK_OPTION_REGIME_MARKET_START=09:15
STOCK_OPTION_REGIME_ENTRY_CUTOFF=15:24
STOCK_OPTION_REGIME_MARKET_END=15:25

# The same LTP-anchored 200-depth premodel cadence used by NIFTY paper mode.
DEEPLOB_PREMODEL_SAMPLE_INTERVAL_MS=250
DEEPLOB_PREMODEL_SIGNAL_INTERVAL_SEC=1
DEEPLOB_PREMODEL_SEQUENCE_LENGTH=12
DEEPLOB_PREMODEL_SIGNAL_THRESHOLD=0.08
DEEPLOB_PREMODEL_HORIZONS_SEC=30,60,120,300
DEEPLOB_PREMODEL_OPTION_BETA_PCT_PER_FUTURE_BPS=0.10
DEEPLOB_STALE_AFTER_SEC=1.5
DEEPLOB_INFERENCE_QUEUE_SIZE=64
